{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Bash(* | bash)",
      "Bash(* | sh)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nc:*)"
    ]
  },
  "enabledPlugins": {
    "interface-design@interface-design": true,
    "vanilla-rails@iuhoay-skills": true,
    "impeccable@impeccable": true,
    "evo@evo-hq-evo": true,
    "claude-seo@agricidaniel-claude-seo": true,
    "ai-security@claude-code-plugins-dev": true,
    "liquid-glass@liquid-glass-skills": true,
    "ponytail@ponytail": true,
    "skills-cleaner@skills-cleaner": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable",
        "ref": "b5af865d84bc1ba1b8bc7104488bc7db50977029"
      }
    },
    "evo-hq-evo": {
      "source": {
        "source": "github",
        "repo": "evo-hq/evo",
        "ref": "f70a7e30cef240077e8253ff199fc61003f4ee71"
      }
    },
    "radar-suite": {
      "source": {
        "source": "github",
        "repo": "Terryc21/radar-suite",
        "ref": "v2.1.1"
      }
    },
    "agricidaniel-claude-seo": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-seo",
        "ref": "v2.0.0"
      }
    },
    "claude-code-plugins-dev": {
      "source": {
        "source": "github",
        "repo": "charlesjones-dev/claude-code-plugins-dev",
        "ref": "v1.5.0"
      }
    },
    "liquid-glass-skills": {
      "source": {
        "source": "github",
        "repo": "haider-nawaz/liquid-glass-skill",
        "ref": "2c1b2789c30dc2c9208f3b9a3811d42480714577"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v4.7.0"
      }
