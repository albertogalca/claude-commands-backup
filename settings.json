    "skills-cleaner": {
      "source": {
        "source": "github",
        "repo": "amebahead/skills-cleaner",
        "ref": "v1.2.5"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen"
}
